navis-branding.jar:
% content branding %content/branding/ contentaccessible=yes
  content/branding/icon16.png (generated/default16.png)
  content/branding/icon32.png (generated/default32.png)
  content/branding/icon48.png (generated/default48.png)
  content/branding/icon64.png (generated/default64.png)
  content/branding/icon128.png (generated/default128.png)
  content/branding/about-logo.svg (generated/navis-mark.svg)

[localization] @AB_CD@.jar:
  branding (locales/en-US/**/*.ftl)

@AB_CD@.jar:
% locale branding @AB_CD@ %locale/branding/
  locale/branding/brand.properties (locales/en-US/brand.properties)
