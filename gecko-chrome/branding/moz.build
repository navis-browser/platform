JAR_MANIFESTS += ["jar.mn"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    GeneratedFile(
        "VisualElements_70.png",
        script="generate_visual_elements.py",
        inputs=["generated/VisualElements_70.png"],
    )
    FINAL_TARGET_FILES.VisualElements += ["!VisualElements_70.png"]
    FINAL_TARGET_FILES.VisualElements += ["generated/VisualElements_150.png"]
    FINAL_TARGET_FILES += ["navis.VisualElementsManifest.xml"]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    FINAL_TARGET_FILES.chrome.icons.default += [
        "generated/default128.png",
        "generated/default16.png",
        "generated/default256.png",
        "generated/default32.png",
        "generated/default48.png",
        "generated/default64.png",
    ]
