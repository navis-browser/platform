if CONFIG["MOZ_WEBEXTENSIONS_RUNTIME"]:
    # The registry is a collection. Each reviewed artifact remains explicit in
    # the build graph, while the installer and verifier handle the full set.
    FINAL_TARGET_FILES["builtin-extensions"] += ["extensions.json"]
    FINAL_TARGET_FILES.extensions += [
        "ublock-origin/uBlock0@raymondhill.net.xpi",
    ]
