if CONFIG["MOZ_WEBEXTENSIONS_RUNTIME"]:
    # Locale packs are application data, not entries in the user-facing
    # built-in extension collection. Gecko discovers them through the same
    # application-global XPI directory and exposes only their locale type.
    FINAL_TARGET_FILES.extensions += [
        "zh-CN/langpack-zh-CN@firefox.mozilla.org.xpi",
    ]
