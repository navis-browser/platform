    <string name="settings_process_isolation">Site isolation</string>
    <string name="settings_process_summary">Choose how Navis separates website processes. Stronger isolation can use more memory.</string>
    <string name="settings_process_invariant">Every mode keeps web content in remote, sandboxed processes. A change applies after relaunch.</string>
    <string name="settings_process_full">Full (recommended)</string>
    <string name="settings_process_full_summary">Isolate all sites with a determinable origin. The default and strongest separation.</string>
    <string name="settings_process_selective">Selective</string>
    <string name="settings_process_selective_summary">Isolate sites that Gecko identifies as high-value, including sensitive sign-in sites. Other sites may share processes.</string>
    <string name="settings_process_shared">Shared</string>
    <string name="settings_process_shared_summary">Ordinary websites may share web processes to reduce memory use. This provides less protection between sites.</string>
    <string name="settings_clean_links">Clean links automatically</string>
    <string name="settings_clean_links_summary">Remove known tracking parameters when you copy links or open eligible cross-site links and redirects, in normal and private browsing.</string>
    <string name="settings_clean_links_scope">The bundled rules work offline. Normal page content is not changed. Same-site links and some extension loads are preserved for compatibility; this does not remove every possible tracker.</string>
