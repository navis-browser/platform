            android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".ProfileActivities$Relaunch2" android:process=":relaunch2"
            android:taskAffinity="${applicationId}.relaunch2" android:excludeFromRecents="true"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity android:name=".ProfileActivities$Browser3" android:process=":profile3"
            android:taskAffinity="${applicationId}.profile3" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask" android:resizeableActivity="true" />
        <activity android:name=".ProfileActivities$Additional3" android:process=":profile3"
            android:taskAffinity="${applicationId}.profile3" android:exported="false"
